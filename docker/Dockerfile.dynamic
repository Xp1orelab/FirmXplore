FROM python:3.12-slim-trixie

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# deb.debian.org 的 Fastly CDN 在受限网络下间歇 502，切换到阿里云镜像
RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || \
    sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list 2>/dev/null || true

# 受限网络下个别包连接会失败，全局重试
RUN echo 'Acquire::Retries "8";\nAcquire::http::Timeout "60";\nAcquire::https::Timeout "60";' > /etc/apt/apt.conf.d/99retry

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        binutils \
        binfmt-support \
        cpio \
        curl \
        file \
        findutils \
        git \
        iproute2 \
        iputils-ping \
        lsof \
        net-tools \
        proot \
        procps \
        python3-pip \
        qemu-system-arm \
        qemu-system-mips \
        qemu-user-static \
        seabios \
        socat \
        tcpdump \
        unzip \
        wget \
        xz-utils \
    && rm -rf /var/lib/apt/lists/*

# FirmAE: clone the framework, but inject pre-downloaded binaries via COPY.
# Historical problem: download.sh fetched kernels from GitHub release-assets at
# build time and silently failed behind restricted networks, leaving /opt/FirmAE
# empty and every later boot failing with "No boot completion marker observed".
# The binaries under docker/firmae-binaries/ are the contents of FirmAE's
# download.sh (kernels from FirmAE_kernel-v2.6 / -v4.1 releases), committed
# alongside this Dockerfile so the build is reproducible offline.
# binwalk-2.3.4 是 FirmAE 的 git submodule（pip 安装与 py312 补丁都需要它）
# 实测：该路径在 FirmAE 仓库中为空，install.sh 通过外网 wget 填充；
# 受限网络下会静默失败，因此与内核一样改为 COPY 预下载源码。
RUN git clone --recursive --depth 1 https://github.com/pr0v3rbs/FirmAE /opt/FirmAE \
    && rm -rf /opt/FirmAE/binaries /opt/FirmAE/binwalk-2.3.4
COPY docker/firmae-binaries/ /opt/FirmAE/binaries/
COPY docker/firmae-binaries-binwalk/ /opt/FirmAE/binwalk-2.3.4/
# Strict verification: boot cannot proceed without the emulation kernels.
RUN test -f /opt/FirmAE/binaries/vmlinux.mipsel.2 \
    && test -f /opt/FirmAE/binaries/busybox.mipsel \
    && test -f /opt/FirmAE/binaries/console.mipsel \
    && test -f /opt/FirmAE/binaries/libnvram.so.mipsel \
    && chmod +x /opt/FirmAE/binaries/*

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        arj \
        bc \
        binwalk \
        busybox-static \
        cabextract \
        dmsetup \
        fakeroot \
        kpartx \
        lhasa \
        lzop \
        mtd-utils \
        netcat-openbsd \
        nmap \
        p7zip-full \
        postgresql \
        python3-bs4 \
        python3-magic \
        python3-requests \
        sleuthkit \
        snmp \
        srecord \
        squashfs-tools \
        uml-utilities \
        vlan \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update \
    && apt-get install -y --no-install-recommends qemu-utils \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update \
    && apt-get install -y --no-install-recommends fdisk e2fsprogs util-linux \
    && rm -rf /var/lib/apt/lists/* \
    && (ln -sf /usr/sbin/fdisk /sbin/fdisk || true)

RUN apt-get update \
    && apt-get install -y --no-install-recommends ipxe-qemu \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir python-magic requests psycopg2-binary

WORKDIR /app
COPY . /app
RUN mkdir -p /opt/fwagent \
    && cp /app/docker/entrypoint-dynamic.sh /opt/fwagent/dynamic-entrypoint.sh \
    && chmod +x /opt/fwagent/dynamic-entrypoint.sh \
    && python /app/scripts/patch_binwalk_py312.py \
    && pip install --no-cache-dir /opt/FirmAE/binwalk-2.3.4 \
    && pip install --no-cache-dir .

WORKDIR /work
ENTRYPOINT ["/opt/fwagent/dynamic-entrypoint.sh"]
